# ---- Where the dashboard lives (exact origin, no trailing slash) ----
PUBLIC_ORIGIN=https://agent.luciuscampany.com
# Only your website may show COMPUTAAA inside a frame (the owner panel).
FRAME_ANCESTORS=https://luciuscampany.com https://www.luciuscampany.com

# ---- Lock 1: Cloudflare Access (see README, step 4) ----
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=paste-the-Application-Audience-AUD-tag-here
OWNER_EMAIL=you@example.com
# Cloudflare Tunnel token (used by the cloudflared container in docker-compose.yml)
CLOUDFLARE_TUNNEL_TOKEN=

# ---- The agent ----
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
AGENT_MAX_STEPS=80

# ---- Agents: name:kind (kind is general or jobs). Each one gets its own browser worker. ----
AGENTS=main:general,jobs:jobs
# One secret per worker (32+ chars each), so a worker can never pose as another:  openssl rand -hex 32
WORKER_TOKEN_MAIN=
WORKER_TOKEN_JOBS=
WORKER_PORT=3001

# Main agent: sites its browser may open (subdomains included). Add a site's login domain too,
# e.g. Gmail needs google.com (which covers mail.google.com and accounts.google.com).
ALLOWED_SITES=google.com,gmail.com
# true = throwaway sessions: starts empty, asks you to sign in, deletes everything when the session ends
MAIN_EPHEMERAL=false

# Jobs agent: job boards, common company application systems, and Gmail for email replies
JOBS_ALLOWED_SITES=culinaryagents.com,linkedin.com,indeed.com,glassdoor.com,craigslist.org,google.com,apple.com,greenhouse.io,lever.co,myworkdayjobs.com,workday.com,icims.com,smartrecruiters.com,ashbyhq.com,jobvite.com,bamboohr.com,workable.com,applytojob.com,breezy.hr,harri.com,hireology.com,paylocity.com,paycomonline.net,dayforcehcm.com,ultipro.com,ukg.com,adp.com,7shifts.com,poachedjobs.com
# On these the agent fills everything but YOU click the final submit (their rules ban bots)
JOBS_FILL_ONLY_SITES=linkedin.com,indeed.com,glassdoor.com,craigslist.org
JOBS_EPHEMERAL=false

# Close the browser after this many idle minutes (frees your logged-in sessions from memory)
IDLE_LOCK_MINUTES=30

# Optional phone alerts via ntfy: install the ntfy app, subscribe to a long random topic name
# NTFY_URL=https://ntfy.sh/computaaa-<long-random-string>

# ---- Server ----
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Used by a worker run outside Docker (npm run worker): set WORKER_NAME / WORKER_TOKEN for it
PROFILE_DIR=./data/profile
CONTROL_URL=ws://127.0.0.1:3001/worker
HEADLESS=true

# Local development only: skips the Cloudflare check. Refused unless PUBLIC_ORIGIN is http://localhost:<port>.
# CF_ACCESS_DISABLED=true
