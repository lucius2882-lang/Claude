# Control plane: dashboard, sign-in, approvals, the Claude agent loop. No browser in this image.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --omit=dev && npm cache clean --force
COPY src ./src
COPY public ./public
COPY scripts ./scripts
ENV NODE_ENV=production HOST=0.0.0.0 WORKER_HOST=0.0.0.0 DATA_DIR=/data
USER node
CMD ["node", "src/server.js"]
